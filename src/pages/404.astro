---
import Base from "../layouts/Base.astro";
import { content } from "../content/profile";
---

<Base locale="pt" noindex>
  <main class="card">
    <a class="mono prompt" href="/" aria-label="telles.dev">
      <span class="dollar">$</span> telles.dev
    </a>

    <div>
      <p class="code mono">404</p>
      <p>{content.pt.notFound}</p>
      <p class="muted" lang="en">{content.en.notFound}</p>
    </div>

    <p class="links">
      <a href="/">{content.pt.notFoundHome}</a>
      <span class="sep">·</span>
      <a href="/en/" lang="en">{content.en.notFoundHome}</a>
    </p>
  </main>
</Base>

<style>
  .card {
    width: 100%;
    max-width: var(--measure);
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .prompt {
    color: var(--fg-muted);
  }

  .dollar {
    color: var(--accent);
  }

  .code {
    margin: 0 0 0.5rem;
    font-size: clamp(2.5rem, 12vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  p {
    margin: 0;
  }

  .muted {
    color: var(--fg-muted);
  }

  .links {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .links a {
    border-bottom: 1px solid var(--accent);
  }
  .links a:hover {
    color: var(--accent);
  }

  .sep {
    color: var(--fg-faint);
  }
</style>
